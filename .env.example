# Secret utilisé par Payload pour signer/chiffrer (sessions, tokens).
# Générer une valeur aléatoire longue (ex. `openssl rand -base64 32`).
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Base SQLite (libSQL). Format libSQL : file:<chemin>.db
#   - En dev local : fichier à la racine du projet.
#   - En conteneur/prod : chemin sur le volume persistant monté (ex. file:/data/passe-finder.db).
# Optionnel en local (défaut : file:./passe-finder.db) ; requis explicitement en prod.
DATABASE_URI=file:./passe-finder.db

# Jeton du site Cloudflare Web Analytics (mesure d'audience).
# Cloudflare > Web Analytics > le site > le champ `token` du snippet.
# FACULTATIF : sans lui, aucun script d'audience n'est chargé et le site
# fonctionne normalement. À laisser vide en local — inutile de mesurer sa
# propre machine, et le site n'appelle alors aucun service tiers.
# Renseignée en local, elle fait apparaître des erreurs CORS dans la console du
# navigateur : Cloudflare n'autorise que `http://localhost` sans port, jamais
# `localhost:3000`. C'est sans gravité et impossible sur le vrai domaine, mais
# c'est du bruit inutile pendant le développement.
# Ne PAS renommer en NEXT_PUBLIC_… : la valeur est lue au rendu, côté serveur.
CLOUDFLARE_ANALYTICS_TOKEN=

# Email du compte à promouvoir ADMINISTRATEUR au démarrage (story 3.4).
# Le drapeau `admin` donne le droit d'éditer le catalogue (danses, positions,
# passes, fichiers). Il ne peut PAS s'attribuer depuis l'application : aucune
# auto-promotion n'est possible, c'est le principe de la story. Cette variable
# est donc la porte prévue pour créer le tout premier administrateur.
# Elle PROMEUT un compte existant, elle n'en crée pas : crée d'abord le compte
# (assistant /admin), renseigne l'email ici, puis redémarre.
# FACULTATIVE et idempotente : sans effet si le compte est déjà admin. Sans
# elle et sans aucun administrateur, le catalogue est en lecture seule pour
# tout le monde — le démarrage le signale dans les logs.
ADMIN_EMAIL=
