# Secret utilisé par Payload pour signer/chiffrer (sessions, tokens).
# Générer une valeur aléatoire longue (ex. `openssl rand -base64 32`).
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Base SQLite (libSQL). Format libSQL : file:<chemin>.db
#   - En dev local : fichier à la racine du projet.
#   - En conteneur/prod : chemin sur le volume persistant monté (ex. file:/data/passe-finder.db).
# Optionnel en local (défaut : file:./passe-finder.db) ; requis explicitement en prod.
DATABASE_URI=file:./passe-finder.db

# Jeton du site Cloudflare Web Analytics (mesure d'audience).
# Cloudflare > Web Analytics > le site > le champ `token` du snippet.
# FACULTATIF : sans lui, aucun script d'audience n'est chargé et le site
# fonctionne normalement. À laisser vide en local — inutile de mesurer sa
# propre machine, et le site n'appelle alors aucun service tiers.
# Renseignée en local, elle fait apparaître des erreurs CORS dans la console du
# navigateur : Cloudflare n'autorise que `http://localhost` sans port, jamais
# `localhost:3000`. C'est sans gravité et impossible sur le vrai domaine, mais
# c'est du bruit inutile pendant le développement.
# Ne PAS renommer en NEXT_PUBLIC_… : la valeur est lue au rendu, côté serveur.
CLOUDFLARE_ANALYTICS_TOKEN=

# Aucune variable pour l'administrateur (story 3.4). Le drapeau `admin` ne peut
# pas s'attribuer depuis l'application, et il se pose une seule fois, à la main,
# quand le compte existe :
#   npm run promouvoir:admin -- ton.email@exemple.fr
# Tant qu'aucun compte ne le porte, le catalogue est en lecture seule pour tout
# le monde et le démarrage le signale dans les logs.

# Adresse publique du site, utilisee pour fabriquer le lien du mail de
# reinitialisation de mot de passe (story 3.3). Le lien part dans un message :
# il n'y a aucun navigateur pour le resoudre, donc il doit etre absolu.
# Facultative en local : a defaut, http://localhost:3000.
# En production, elle se deduit de DOMAINE - inutile de la renseigner deux fois.
SITE_URL=

# Envoi des e-mails (story 3.3). FACULTATIF, et a laisser vide en local :
# sans ces variables, Payload ecrit le message dans la console au lieu de
# l'envoyer, ce qui est parfait pour developper, et la page « mot de passe
# oublie » annonce franchement que la fonction est indisponible.
# Avec Gmail : SMTP_HOTE=smtp.gmail.com, SMTP_UTILISATEUR=l'adresse complete,
# SMTP_MOT_DE_PASSE=un MOT DE PASSE D'APPLICATION (jamais le mot de passe du
# compte Google), genere sur https://myaccount.google.com/apppasswords apres
# activation de la validation en deux etapes.
SMTP_HOTE=
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
# Facultatives : le port vaut 465 par defaut, et l'expediteur reprend
# SMTP_UTILISATEUR. Chez Google, toute autre adresse d'expediteur est reecrite.
SMTP_PORT=
SMTP_EXPEDITEUR=
