# Contexte de build Docker : n'envoyer que le nécessaire.
# Sécurité : ne JAMAIS copier les secrets ni la base locale dans l'image.

# dépendances / artefacts (réinstallés/reconstruits dans l'image)
node_modules
.next
out
build

# secrets & base locale
.env
.env*.local
*.db
*.db-shm
*.db-wal

# outillage & livrables non nécessaires au runtime
.git
.gitignore
.claude
_bmad
_bmad-output
docs

# NB : `images/` et `passe-finder-saveDB.gz` sont VOLONTAIREMENT conservés.
# L'import du catalogue historique s'exécute dans le conteneur au premier
# démarrage ; sans eux, il n'aurait aucune source à lire (~400 Ko au total).

# tests & rapports
tests
test-results
playwright-report
blob-report
playwright/.cache

# divers
Dockerfile
.dockerignore
README.md
*.log
